CREATE OR REPLACE FUNCTION public.fn_get_bus_tracking_overview()
RETURNS TABLE (
    bus_id VARCHAR,
    bus_name VARCHAR,
    driver_name VARCHAR,
    status VARCHAR,
    location_description TEXT,
    current_speed NUMERIC,
    eta_minutes INT,
    next_stop VARCHAR
)
LANGUAGE plpgsql
AS $$
BEGIN
    RETURN QUERY
    SELECT
        bf.bus_id,
        bf.bus_name,
        bf.driver_name,
        bts.status,
        bts.location_description,
        bts.current_speed,
        bts.eta_minutes,
        bts.next_stop
    FROM public.bus_fleet bf
    LEFT JOIN public.bus_tracking_status bts ON bf.bus_id = bts.bus_id
    WHERE bf.is_active = TRUE
    ORDER BY bf.bus_id;
END;
$$;

select * from fn_get_bus_tracking_overview()


