CREATE OR REPLACE VIEW vw_available_labs AS
SELECT id AS lab_id,
       lab_name,
       services,
       rating,
       home_collection,
       is_active,
       latitude,
       longitude,
       upload_prescription,
       proceed_type,
       delivery_address,
       special_instructions
FROM public.available_labs
WHERE is_active = TRUE;


select * from public.vw_available_labs