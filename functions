----create function fn_user_delete_list 
create or replace function fn_user_delete_list(P_email varchar)
returns text 
language plpgsql as
$$
begin
	delete from user_registration where 
        (p_email is not null and email = p_email);       
return 'user deleted successfully';
END;
$$;

